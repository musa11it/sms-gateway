// SMS Gateway SaaS - database schema
// Conventions:
//  - UUID primary keys (CHAR(36)), snake_case table names, camelCase fields.
//  - Money is stored as Decimal(14,2); SMS credits are integers.
//  - Every tenant-owned table carries organizationId and is indexed on it.
//  - audit_logs and wallet_transactions are append-only (enforced by DB triggers, see migrations).
//  - MySQL has no scalar lists: string lists (tags, scopes, routePrefixes, ...) are JSON arrays of strings.
//  - Text columns use the case-insensitive utf8mb4_unicode_ci collation, so text search and unique checks ignore case.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum UserStatus {
  PENDING_EMAIL_VERIFICATION
  PENDING_REVIEW
  ACTIVE
  REJECTED
  SUSPENDED
  DEACTIVATED
}

enum OrganizationStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  REJECTED
  SUSPENDED
}

enum RoleScope {
  PLATFORM
  ORGANIZATION
}

enum MemberStatus {
  ACTIVE
  DISABLED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum VerificationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  MORE_INFORMATION_REQUIRED
  APPROVED
  REJECTED
  SUSPENDED
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
  REPLACEMENT_REQUESTED
}

enum SenderStatus {
  PENDING
  UNDER_REVIEW
  NEEDS_INFORMATION
  APPROVED
  REJECTED
  SUSPENDED
}

enum WalletTransactionType {
  PURCHASE
  SMS_DEBIT
  REFUND
  ADMIN_CREDIT
  ADMIN_DEBIT
  ADJUSTMENT
  EXPIRATION
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  MOBILE_MONEY
  CARD
  BANK_TRANSFER
}

enum InvoiceStatus {
  PAID
  VOID
  REFUNDED
}

enum SmsEncoding {
  GSM7
  UCS2
}

enum SmsSource {
  DASHBOARD
  API
  CAMPAIGN
}

enum SmsBatchStatus {
  SCHEDULED
  QUEUED
  PROCESSING
  SENT
  COMPLETED
  CANCELLED
  FAILED
}

enum SmsRecipientStatus {
  QUEUED
  PROCESSING
  // Accepted by the provider (charged).
  SENT
  DELIVERED
  // Accepted, then the network reported non-delivery (stays charged).
  FAILED
  EXPIRED
  CANCELLED
  // Never accepted by a provider: rejected at submission or not accepted in time (refunded).
  REJECTED
}

enum DeliveryReportSource {
  SUBMISSION
  CALLBACK
  POLL
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  QUEUED
  PROCESSING
  COMPLETED
  PARTIALLY_COMPLETED
  FAILED
  CANCELLED
}

enum ContactStatus {
  ACTIVE
  UNSUBSCRIBED
  BLOCKED
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  RETRYING
  FAILED
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

enum ActorType {
  USER
  API_KEY
  SYSTEM
}

// ─────────────────────────────────────────────────────────────
// Identity & access
// ─────────────────────────────────────────────────────────────

model User {
  id                String     @id @default(uuid()) @db.Char(36)
  email             String     @unique @db.VarChar(255)
  phone             String?    @unique
  fullName          String
  passwordHash      String
  status            UserStatus @default(PENDING_EMAIL_VERIFICATION)
  emailVerifiedAt   DateTime?
  phoneVerifiedAt   DateTime?
  lastLoginAt       DateTime?
  statusReason      String?    @db.Text
  passwordChangedAt DateTime?
  // Non-interactive identity used by an API credential: cannot sign in, reset a password or hold a session.
  isServiceAccount  Boolean    @default(false)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  sessions           Session[]
  tokens             UserToken[]
  roles              UserRole[]
  memberships        OrganizationMember[]
  notifications      Notification[]
  invitationsSent    OrganizationInvitation[] @relation("InvitedBy")
  auditLogs          AuditLog[]
  walletTransactions WalletTransaction[]
  apiKeysCreated     ApiKey[]

  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model Session {
  id               String    @id @default(uuid()) @db.Char(36)
  userId           String    @db.Char(36)
  refreshTokenHash String    @unique
  userAgent        String?   @db.Text
  ipAddress        String?
  expiresAt        DateTime
  lastUsedAt       DateTime  @default(now())
  revokedAt        DateTime?
  revokedReason    String?   @db.Text
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum UserTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  PHONE_VERIFICATION
}

model UserToken {
  id        String        @id @default(uuid()) @db.Char(36)
  userId    String        @db.Char(36)
  type      UserTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("user_tokens")
}

model Permission {
  id          String    @id @default(uuid()) @db.Char(36)
  key         String
  scope       RoleScope
  group       String
  description String    @db.Text
  createdAt   DateTime  @default(now())

  roles RolePermission[]

  @@unique([key, scope])
  @@map("permissions")
}

model Role {
  id             String    @id @default(uuid()) @db.Char(36)
  // Stable machine name for system roles (e.g. SUPER_ADMIN); unique per scope/organization.
  code           String
  name           String
  description    String?   @db.Text
  scope          RoleScope
  isSystem       Boolean   @default(false)
  // null = platform-wide role definition; set = custom role owned by one organization.
  organizationId String?   @db.Char(36)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization?            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  users        UserRole[]
  members      OrganizationMember[]
  invitations  OrganizationInvitation[]

  @@unique([scope, organizationId, code])
  @@index([organizationId])
  @@map("roles")
}

model RolePermission {
  roleId       String   @db.Char(36)
  permissionId String   @db.Char(36)
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// Platform (staff) role assignment
model UserRole {
  userId       String   @db.Char(36)
  roleId       String   @db.Char(36)
  assignedById String?  @db.Char(36)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ─────────────────────────────────────────────────────────────
// Organizations / tenants
// ─────────────────────────────────────────────────────────────

model Organization {
  id                    String             @id @default(uuid()) @db.Char(36)
  name                  String
  slug                  String             @unique
  status                OrganizationStatus @default(DRAFT)
  statusReason          String?            @db.Text
  businessType          String?
  country               String?
  address               String?            @db.Text
  city                  String?
  registrationNumber    String?
  taxId                 String?
  website               String?            @db.Text
  contactPersonName     String?
  contactPersonPhone    String?
  contactPersonEmail    String?            @db.Text
  smsPurpose            String?            @db.Text
  expectedMonthlyVolume Int?
  // Optional per-organization cap on recipients per hour (null = platform default)
  smsHourlyLimit        Int?
  // Platform control over API keys: switch the whole organization off, or cap its scopes (null = all).
  apiAccessEnabled      Boolean            @default(true)
  apiAllowedScopes      Json?
  timezone              String             @default("Africa/Kigali")
  approvedAt            DateTime?
  suspendedAt           DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  members           OrganizationMember[]
  invitations       OrganizationInvitation[]
  roles             Role[]
  verifications     Verification[]
  documents         VerificationDocument[]
  wallet            Wallet?
  senders           SenderId[]
  contacts          Contact[]
  contactGroups     ContactGroup[]
  campaigns         Campaign[]
  smsMessages       SmsMessage[]
  smsRecipients     SmsRecipient[]
  payments          Payment[]
  invoices          Invoice[]
  apiKeys           ApiKey[]
  apiLogs           ApiRequestLog[]
  webhooks          Webhook[]
  customerPurchases CustomerPurchase[]
  refunds           Refund[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  walletTxns        WalletTransaction[]
  senderAllocations SenderIdAllocation[]

  @@index([status])
  @@index([createdAt])
  @@map("organizations")
}

model OrganizationMember {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  userId         String       @db.Char(36)
  roleId         String       @db.Char(36)
  status         MemberStatus @default(ACTIVE)
  isOwner        Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model OrganizationInvitation {
  id             String           @id @default(uuid()) @db.Char(36)
  organizationId String           @db.Char(36)
  email          String           @db.VarChar(255)
  roleId         String           @db.Char(36)
  tokenHash      String           @unique
  status         InvitationStatus @default(PENDING)
  invitedById    String           @db.Char(36)
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitedBy    User         @relation("InvitedBy", fields: [invitedById], references: [id])

  @@index([organizationId, status])
  @@index([email])
  @@map("organization_invitations")
}

// ─────────────────────────────────────────────────────────────
// Verification (KYB)
// ─────────────────────────────────────────────────────────────

model Verification {
  id             String             @id @default(uuid()) @db.Char(36)
  organizationId String             @db.Char(36)
  status         VerificationStatus @default(DRAFT)
  submittedAt    DateTime?
  submittedById  String?            @db.Char(36)
  reviewedAt     DateTime?
  reviewedById   String?            @db.Char(36)
  reviewNote     String?            @db.Text
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents    VerificationDocument[]
  reviews      VerificationReview[]

  @@index([organizationId])
  @@index([status])
  @@map("verifications")
}

// Immutable history of every review decision on a verification.
model VerificationReview {
  id             String   @id @default(uuid()) @db.Char(36)
  verificationId String   @db.Char(36)
  organizationId String   @db.Char(36)
  reviewerId     String?  @db.Char(36)
  action         String
  fromStatus     String?
  toStatus       String?
  note           String?  @db.Text
  createdAt      DateTime @default(now())

  verification Verification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@index([verificationId, createdAt])
  @@map("verification_reviews")
}

model VerificationDocument {
  id             String         @id @default(uuid()) @db.Char(36)
  organizationId String         @db.Char(36)
  verificationId String         @db.Char(36)
  documentType   String
  originalName   String         @db.Text
  // For URL / TEXT / DATE / SELECT requirements the answer lives here and the file columns are null.
  value          String?        @db.Text
  mimeType       String?
  sizeBytes      Int?
  // Opaque storage key relative to the configured storage root. Never returned to clients.
  storageKey     String?        @unique
  checksum       String?
  status         DocumentStatus @default(PENDING)
  reviewNote     String?        @db.Text
  uploadedById   String         @db.Char(36)
  reviewedById   String?        @db.Char(36)
  reviewedAt     DateTime?
  createdAt      DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  verification Verification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([verificationId])
  @@map("verification_documents")
}

// ─────────────────────────────────────────────────────────────
// Sender IDs
// ─────────────────────────────────────────────────────────────

model SenderId {
  id                 String       @id @default(uuid()) @db.Char(36)
  organizationId     String       @db.Char(36)
  name               String
  status             SenderStatus @default(PENDING)
  purpose            String       @db.Text
  sampleMessage      String?      @db.Text
  useCase            String?      @db.Text
  reviewNote         String?      @db.Text
  // Requested for specific telecoms: usable only on networks where its SenderIdNetwork row is APPROVED.
  restrictToNetworks Boolean      @default(false)
  requestedById      String       @db.Char(36)
  reviewedById       String?      @db.Char(36)
  reviewedAt         DateTime?
  approvedAt         DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  organization  Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  smsMessages   SmsMessage[]
  campaigns     Campaign[]
  reviews       SenderIdReview[]
  registrations SenderIdRegistration[]
  allocation    SenderIdAllocation?
  networks      SenderIdNetwork[]

  @@unique([organizationId, name])
  @@index([status])
  @@index([name])
  @@map("sender_ids")
}

model SenderIdReview {
  id             String   @id @default(uuid()) @db.Char(36)
  senderId       String   @db.Char(36)
  organizationId String   @db.Char(36)
  reviewerId     String?  @db.Char(36)
  action         String
  fromStatus     String
  toStatus       String
  note           String?  @db.Text
  createdAt      DateTime @default(now())

  sender SenderId @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId, createdAt])
  @@map("sender_id_reviews")
}

// Registration of an approved sender ID with each upstream provider/network.
model SenderIdRegistration {
  id                String   @id @default(uuid()) @db.Char(36)
  senderId          String   @db.Char(36)
  providerId        String   @db.Char(36)
  status            String
  providerReference String?
  message           String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  sender   SenderId    @relation(fields: [senderId], references: [id], onDelete: Cascade)
  provider SmsProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([senderId, providerId])
  @@map("sender_id_registrations")
}

enum SenderNetworkStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

// Approval of a sender ID on one destination network. Only consulted for networks with
// requiresSenderRegistration; an APPROVED row is the only proof of compatibility (never the name).
model SenderIdNetwork {
  id             String              @id @default(uuid()) @db.Char(36)
  senderId       String              @db.Char(36)
  organizationId String              @db.Char(36)
  networkId      String              @db.Char(36)
  status         SenderNetworkStatus @default(PENDING)
  note           String?             @db.Text
  reviewedById   String?             @db.Char(36)
  reviewedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  sender  SenderId   @relation(fields: [senderId], references: [id], onDelete: Cascade)
  network SmsNetwork @relation(fields: [networkId], references: [id], onDelete: Restrict)

  @@unique([senderId, networkId])
  @@index([organizationId])
  @@index([networkId, status])
  @@map("sender_id_networks")
}

// Part of the organization's wallet reserved for one sender ID. It is a reservation of real wallet
// credits, never extra credits: the remaining amounts (allocated - used) of all active allocations
// can never exceed the wallet balance at the time they are set.
model SenderIdAllocation {
  id                 String   @id @default(uuid()) @db.Char(36)
  organizationId     String   @db.Char(36)
  senderId           String   @unique @db.Char(36)
  allocated          Int
  used               Int      @default(0)
  isActive           Boolean  @default(true)
  // Remaining-percentage thresholds that trigger a reminder, e.g. [50, 25, 10].
  alertThresholds    Json
  // Lowest threshold already notified since the allocation was last topped up (null = none).
  lastAlertThreshold Int?
  createdById        String?  @db.Char(36)
  updatedById        String?  @db.Char(36)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sender       SenderId     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("sender_id_allocations")
}

// ─────────────────────────────────────────────────────────────
// Upstream SMS providers (our supply side)
// ─────────────────────────────────────────────────────────────

enum ProviderType {
  MNO
  AGGREGATOR
}

enum ProviderMode {
  SIMULATION
  PRODUCTION
}

enum ProviderStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ProviderPurchaseStatus {
  PENDING
  SUCCESS
  FAILED
}

enum ProviderHealth {
  HEALTHY
  DEGRADED
  DOWN
}

enum ProviderLotSource {
  OPENING
  PURCHASE
  ADJUSTMENT
  RETURN
}

// LOWEST_COST / PRIORITY order the rule's provider pool; PRIMARY_BACKUP tries an explicit ordered list.
enum RoutingStrategy {
  PRIORITY
  LOWEST_COST
  PRIMARY_BACKUP
}

enum CapacityEntryType {
  PURCHASE
  USAGE
  RELEASE
  ADJUSTMENT
}

model SmsProvider {
  id                    String         @id @default(uuid()) @db.Char(36)
  // Stable code used to resolve the adapter (e.g. MTN + SIMULATION -> "mtn:simulation").
  code                  String         @unique
  name                  String
  type                  ProviderType
  mode                  ProviderMode   @default(SIMULATION)
  status                ProviderStatus @default(ACTIVE)
  currency              String         @default("RWF")
  // Current price quoted by the provider per SMS (default unit cost for new purchases).
  costPerSms            Decimal        @db.Decimal(14, 4)
  // Legacy (pre-network routing) prefix list; kept for history, no longer used for routing.
  routePrefixes         Json
  priority              Int            @default(100)
  // Legacy catch-all flag, no longer used: capability is explicit per country (`countries`) or network (`networks`).
  servesAllDestinations Boolean        @default(false)
  supportsSenderId      Boolean        @default(true)
  health                ProviderHealth @default(HEALTHY)
  healthNote            String?        @db.Text
  // Capacity kept in reserve: the provider is skipped once a send would leave less than this.
  minimumCapacity       Int            @default(0)
  // Capacity inventory (always changed together with the append-only capacity ledger).
  capacityBalance       Int            @default(0)
  totalPurchased        Int            @default(0)
  totalUsed             Int            @default(0)
  totalSpent            Decimal        @default(0) @db.Decimal(14, 2)
  allowOverdraft        Boolean        @default(false)
  overdraftLimit        Int            @default(0)
  lowCapacityThreshold  Int            @default(10000)
  notes                 String?        @db.Text
  // How production traffic reaches this provider: "NONE" (simulation only / code adapter) or "HTTP_JSON" (configured below).
  adapterType           String         @default("NONE")
  // HTTP_JSON settings (URLs, auth, templates, mappings). The API key is stored encrypted and never returned.
  adapterConfig         Json?
  lastTransactionAt     DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  purchases     ProviderPurchase[]
  ledger        ProviderCapacityLedger[]
  recipients    SmsRecipient[]
  registrations SenderIdRegistration[]
  lots          ProviderCapacityLot[]
  networks      SmsProviderNetwork[]
  countries     SmsProviderCountry[]
  primaryRules  SmsRoutingRule[]         @relation("RulePrimaryProvider")

  @@index([status])
  @@map("sms_providers")
}

enum NumberValidationMode {
  // Number must match the country's numbering plan (valid ranges and lengths).
  STRICT
  // Number must only have a possible length for the country (for new ranges not yet in the plan data).
  LENGTH
}

// Destination countries the platform sends to. A number is only routable if its country is
// configured and active here. The calling code comes from the numbering-plan data (by ISO code).
model SmsCountry {
  id                    String               @id @default(uuid()) @db.Char(36)
  isoCode               String               @unique @db.Char(2)
  name                  String
  isActive              Boolean              @default(true)
  validationMode        NumberValidationMode @default(STRICT)
  // Optional extra rule: accepted national number lengths (digits after the country code). Empty = plan only.
  nationalNumberLengths Json
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  networks  SmsNetwork[]
  providers SmsProviderCountry[]

  @@map("sms_countries")
}

// A provider can deliver to every number of a country (any network, including numbers on no configured network).
model SmsProviderCountry {
  providerId String   @db.Char(36)
  countryId  String   @db.Char(36)
  createdAt  DateTime @default(now())

  provider SmsProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  country  SmsCountry  @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@id([providerId, countryId])
  @@index([countryId])
  @@map("sms_provider_countries")
}

// Destination networks (country + mobile network, identified by E.164 prefixes). Database-driven.
model SmsNetwork {
  id                         String   @id @default(uuid()) @db.Char(36)
  code                       String   @unique
  name                       String
  countryCode                String   @db.Char(2)
  // Copy of the country name (kept in sync); the country row is authoritative.
  countryName                String
  // E.164 prefixes (JSON array of strings, e.g. ["+25078", "+25079"]).
  prefixes                   Json
  // Optional extra rule: accepted national number lengths for this network (null/empty = country rules).
  nationalNumberLengths      Json?
  isActive                   Boolean  @default(true)
  // Temporarily closed: nothing can be bought for it or sent to it (history kept). isActive=false retires it.
  inMaintenance              Boolean  @default(false)
  maintenanceNote            String?  @db.Text
  // Sender IDs need an APPROVED per-network registration (SenderIdNetwork) before sending here.
  requiresSenderRegistration Boolean  @default(false)
  // Message directions the platform actually offers on this network (inbound is not implemented yet).
  supportsOutbound           Boolean  @default(true)
  supportsInbound            Boolean  @default(false)
  sortOrder                  Int      @default(0)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  country         SmsCountry           @relation(fields: [countryCode], references: [isoCode], onDelete: Restrict)
  providers       SmsProviderNetwork[]
  rules           SmsRoutingRule[]
  recipients      SmsRecipient[]
  pricingTiers    SmsPricingTier[]
  creditLots      SmsCreditLot[]
  paymentItems    PaymentItem[]
  senderApprovals SenderIdNetwork[]
  priceLists      SmsPriceList[]

  @@index([countryCode])
  @@map("sms_networks")
}

// Which destination networks a provider can deliver to (not limited to its own network).
model SmsProviderNetwork {
  providerId String   @db.Char(36)
  networkId  String   @db.Char(36)
  createdAt  DateTime @default(now())

  provider SmsProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  network  SmsNetwork  @relation(fields: [networkId], references: [id], onDelete: Cascade)

  @@id([providerId, networkId])
  @@index([networkId])
  @@map("sms_provider_networks")
}

// A block of provider capacity with its own unit cost. capacityBalance = Σ remaining; usage
// consumes lots oldest-first and records which lots (and costs) were used.
model ProviderCapacityLot {
  id         String            @id @default(uuid()) @db.Char(36)
  providerId String            @db.Char(36)
  purchaseId String?           @unique @db.Char(36)
  source     ProviderLotSource
  quantity   Int
  remaining  Int
  unitCost   Decimal           @db.Decimal(14, 4)
  reference  String
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  provider     SmsProvider              @relation(fields: [providerId], references: [id], onDelete: Restrict)
  purchase     ProviderPurchase?        @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  consumptions ProviderLotConsumption[]

  @@index([providerId, remaining, createdAt])
  @@map("provider_capacity_lots")
}

// Capacity taken from a lot by one ledger movement (usage or negative adjustment).
model ProviderLotConsumption {
  id            String   @id @default(uuid()) @db.Char(36)
  lotId         String   @db.Char(36)
  ledgerEntryId String   @db.Char(36)
  quantity      Int
  // Capacity later given back to the lot (rejected or cancelled messages).
  returned      Int      @default(0)
  unitCost      Decimal  @db.Decimal(14, 4)
  createdAt     DateTime @default(now())

  lot         ProviderCapacityLot    @relation(fields: [lotId], references: [id], onDelete: Restrict)
  ledgerEntry ProviderCapacityLedger @relation(fields: [ledgerEntryId], references: [id], onDelete: Restrict)

  @@index([ledgerEntryId])
  @@index([lotId])
  @@map("provider_lot_consumptions")
}

// Super Admin routing rules. The first active rule (lowest priority number) matching the
// destination decides which providers may carry it and in which order.
model SmsRoutingRule {
  id                  String          @id @default(uuid()) @db.Char(36)
  name                String
  priority            Int
  // null = any country / any network
  countryCode         String?         @db.Char(2)
  networkId           String?         @db.Char(36)
  strategy            RoutingStrategy @default(PRIORITY)
  // PRIMARY_BACKUP only: the provider tried first, then backups in order (JSON array of provider ids).
  primaryProviderId   String?         @db.Char(36)
  backupProviderIds   Json
  // LOWEST_COST / PRIORITY only: the provider pool (JSON array of ids). Empty = every provider serving the destination.
  allowedProviderIds  Json
  minProviderCapacity Int             @default(0)
  maxCostPerSegment   Decimal?        @db.Decimal(14, 4)
  isActive            Boolean         @default(true)
  description         String?         @db.Text
  createdById         String?         @db.Char(36)
  updatedById         String?         @db.Char(36)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  network         SmsNetwork?    @relation(fields: [networkId], references: [id], onDelete: Restrict)
  primaryProvider SmsProvider?   @relation("RulePrimaryProvider", fields: [primaryProviderId], references: [id], onDelete: Restrict)
  recipients      SmsRecipient[]

  @@index([isActive, priority])
  @@map("sms_routing_rules")
}

model ProviderPurchase {
  id                String                 @id @default(uuid()) @db.Char(36)
  reference         String                 @unique
  providerId        String                 @db.Char(36)
  quantity          Int
  unitCost          Decimal                @db.Decimal(14, 4)
  totalCost         Decimal                @db.Decimal(14, 2)
  currency          String
  status            ProviderPurchaseStatus @default(PENDING)
  providerReference String?
  failureReason     String?                @db.Text
  notes             String?                @db.Text
  createdById       String?                @db.Char(36)
  completedAt       DateTime?
  createdAt         DateTime               @default(now())

  provider SmsProvider          @relation(fields: [providerId], references: [id], onDelete: Restrict)
  lot      ProviderCapacityLot?

  @@index([providerId, createdAt])
  @@index([status, createdAt])
  @@map("provider_purchases")
}

model ProviderCapacityLedger {
  id            String            @id @default(uuid()) @db.Char(36)
  providerId    String            @db.Char(36)
  type          CapacityEntryType
  // Signed SMS count: + adds capacity, - consumes it.
  amount        Int
  balanceBefore Int
  balanceAfter  Int
  // Idempotency reference (purchase:<id>, usage:<messageId>:<providerId>, release:<recipientId>:<n> ...)
  reference     String            @unique
  description   String            @db.Text
  unitCost      Decimal?          @db.Decimal(14, 4)
  createdById   String?           @db.Char(36)
  createdAt     DateTime          @default(now())

  provider     SmsProvider              @relation(fields: [providerId], references: [id], onDelete: Restrict)
  consumptions ProviderLotConsumption[]

  @@index([providerId, createdAt])
  @@map("provider_capacity_ledger")
}

// ─────────────────────────────────────────────────────────────
// Wallet & billing
// ─────────────────────────────────────────────────────────────

model Wallet {
  id                   String    @id @default(uuid()) @db.Char(36)
  organizationId       String    @unique @db.Char(36)
  balance              Int       @default(0)
  lowBalanceThreshold  Int       @default(500)
  lowBalanceNotifiedAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
  creditLots   SmsCreditLot[]

  @@map("wallets")
}

model WalletTransaction {
  id             String                @id @default(uuid()) @db.Char(36)
  walletId       String                @db.Char(36)
  organizationId String                @db.Char(36)
  type           WalletTransactionType
  // Signed credit amount: positive = credit, negative = debit.
  amount         Int
  balanceBefore  Int
  balanceAfter   Int
  // Idempotency reference (e.g. payment:<id>, sms:<id>, refund:sms:<recipientId>).
  reference      String                @unique
  description    String                @db.Text
  createdById    String?               @db.Char(36)
  metadata       Json?
  createdAt      DateTime              @default(now())

  wallet       Wallet       @relation(fields: [walletId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation(fields: [createdById], references: [id])

  @@index([organizationId, createdAt])
  @@index([type])
  @@map("wallet_transactions")
}

model SmsPackage {
  id                    String   @id @default(uuid()) @db.Char(36)
  name                  String
  description           String?  @db.Text
  credits               Int
  price                 Decimal  @db.Decimal(14, 2)
  currency              String   @default("RWF")
  // Optional explicit provider-cost estimate for the whole package (margin planning).
  estimatedProviderCost Decimal? @db.Decimal(14, 2)
  validityDays          Int?
  isActive              Boolean  @default(true)
  isPopular             Boolean  @default(false)
  sortOrder             Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  payments          Payment[]
  customerPurchases CustomerPurchase[]

  @@index([isActive])
  @@map("sms_packages")
}

// Volume pricing for any-quantity purchases. The tier containing the purchased quantity sets the
// unit price for the whole purchase (simple tier price, not graduated). Active tiers never overlap.
// Each tier belongs to one price list: general credits (networkId null, usable on any network) or one
// destination network (credits usable only there). Active tiers of the same list never overlap in
// quantity during overlapping effective periods, so at most one tier prices a purchase.
model SmsPricingTier {
  id            String           @id @default(uuid()) @db.Char(36)
  name          String?
  // null = general credits (any network)
  networkId     String?          @db.Char(36)
  service       SmsService       @default(BULK_SMS)
  direction     MessageDirection @default(OUTBOUND)
  minQuantity   Int
  // null = no upper bound
  maxQuantity   Int?
  unitPrice     Decimal          @db.Decimal(14, 4)
  currency      String           @default("RWF")
  isActive      Boolean          @default(true)
  sortOrder     Int              @default(0)
  // Effective period (null = open-ended). Lets a new price be scheduled without editing the current one.
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  createdById   String?          @db.Char(36)
  updatedById   String?          @db.Char(36)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  network      SmsNetwork?   @relation(fields: [networkId], references: [id], onDelete: Restrict)
  payments     Payment[]
  paymentItems PaymentItem[]

  @@index([isActive, minQuantity])
  @@index([networkId, direction, isActive])
  @@map("sms_pricing_tiers")
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

// SMS products the platform actually sells. Only Bulk SMS is implemented; add a value only together
// with a working service.
enum SmsService {
  BULK_SMS
}

// What selects the tier of a purchase.
enum PricingMetric {
  // The quantity bought in this purchase line.
  PURCHASE_QUANTITY
  // The quantity bought for the same price list in the current calendar month (UTC), this line included.
  MONTHLY_PURCHASE_QUANTITY
}

// How tier rates apply to the units of a purchase.
enum RateApplication {
  // Every unit is charged at the rate of the tier the (end) volume falls in.
  WHOLE_PURCHASE
  // Each unit is charged at the rate of the tier its own position falls in (incremental/graduated).
  GRADUATED
}

// Pricing configuration of one price list: general credits (networkId null) or one destination network,
// for one service and direction. Its tiers are the SmsPricingTier rows with the same network, service and
// direction. A missing row means the defaults (purchase quantity, whole purchase, active). There are no fees.
model SmsPriceList {
  id                  String           @id @default(uuid()) @db.Char(36)
  // "<networkId|general>:<service>:<direction>", unique (MySQL unique indexes ignore NULL networkId).
  scopeKey            String           @unique
  networkId           String?          @db.Char(36)
  service             SmsService       @default(BULK_SMS)
  direction           MessageDirection @default(OUTBOUND)
  pricingMetric       PricingMetric    @default(PURCHASE_QUANTITY)
  rateApplication     RateApplication  @default(WHOLE_PURCHASE)
  minPurchaseQuantity Int?
  maxPurchaseQuantity Int?
  // Shown to customers next to the prices (limitations, notes).
  customerNotes       String?          @db.Text
  isActive            Boolean          @default(true)
  createdById         String?          @db.Char(36)
  updatedById         String?          @db.Char(36)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  network      SmsNetwork?   @relation(fields: [networkId], references: [id], onDelete: Restrict)
  paymentItems PaymentItem[]

  @@index([networkId])
  @@map("sms_price_lists")
}

// A batch of credits in a wallet with its own expiry. The wallet balance always equals the sum of
// `remaining` over its lots; debits consume lots first-expiring-first-out (FEFO).
model SmsCreditLot {
  id                  String                @id @default(uuid()) @db.Char(36)
  walletId            String                @db.Char(36)
  organizationId      String                @db.Char(36)
  // Ledger entry that created the lot (null for balances that predate credit lots).
  sourceTransactionId String?               @unique @db.Char(36)
  sourceType          WalletTransactionType
  credits             Int
  remaining           Int
  // Selling price of one credit in this lot, frozen at purchase (null = credits given for free, e.g.
  // admin credit). Revenue of every SMS segment drawn from the lot uses this price, never today's.
  unitPrice           Decimal?              @db.Decimal(14, 4)
  // Destination network the credits were bought for (null = general credits, usable on any network).
  // Network credits are only ever spent on recipients of that network; they are never moved or merged.
  networkId           String?               @db.Char(36)
  // null = never expires
  expiresAt           DateTime?
  expiredAt           DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  wallet  Wallet      @relation(fields: [walletId], references: [id], onDelete: Restrict)
  network SmsNetwork? @relation(fields: [networkId], references: [id], onDelete: Restrict)

  @@index([walletId, remaining, expiresAt])
  @@index([walletId, networkId, remaining])
  @@index([expiresAt, remaining])
  @@map("sms_credit_lots")
}

model Payment {
  id                 String        @id @default(uuid()) @db.Char(36)
  organizationId     String        @db.Char(36)
  packageId          String?       @db.Char(36)
  // Our reference, sent to the provider. Unique.
  reference          String        @unique
  provider           String
  providerReference  String?       @unique
  method             PaymentMethod
  payerPhone         String?
  // Snapshot of what was purchased (package may change later).
  packageName        String
  credits            Int
  amount             Decimal       @db.Decimal(14, 2)
  currency           String
  status             PaymentStatus @default(PENDING)
  // Processing fee charged by the payment provider (reported by provider, else configured rate).
  feeAmount          Decimal       @default(0) @db.Decimal(14, 2)
  failureReason      String?       @db.Text
  createdById        String?       @db.Char(36)
  verifiedAt         DateTime?
  creditedAt         DateTime?
  refundedAt         DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  // Tier-priced (any-quantity) purchases: snapshot of the tier and unit price used at checkout.
  pricingTierId      String?       @db.Char(36)
  unitPrice          Decimal?      @db.Decimal(14, 4)
  tierMinQuantity    Int?
  tierMaxQuantity    Int?
  // Validity of the purchased credits in days, fixed at checkout (null = never expire).
  creditValidityDays Int?

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  package      SmsPackage?       @relation(fields: [packageId], references: [id], onDelete: SetNull)
  pricingTier  SmsPricingTier?   @relation(fields: [pricingTierId], references: [id], onDelete: Restrict)
  invoice      Invoice?
  events       PaymentEvent[]
  purchase     CustomerPurchase?
  refund       Refund?
  items        PaymentItem[]

  @@index([organizationId, createdAt])
  @@index([status])
  @@map("payments")
}

// One destination-network line of a purchase, priced by the server at checkout and frozen here.
// On success each line becomes its own network credit lot (wallet reference payment:<paymentId>:<itemId>).
model PaymentItem {
  id                 String           @id @default(uuid()) @db.Char(36)
  paymentId          String           @db.Char(36)
  networkId          String           @db.Char(36)
  // Snapshot of the destination at checkout (names may change later).
  networkName        String
  countryCode        String           @db.Char(2)
  direction          MessageDirection @default(OUTBOUND)
  quantity           Int
  pricingTierId      String           @db.Char(36)
  tierMinQuantity    Int
  tierMaxQuantity    Int?
  // Average price per SMS of the line (subtotal ÷ quantity, 4 dp): the selling price frozen on its credit lot.
  unitPrice          Decimal          @db.Decimal(14, 4)
  subtotal           Decimal          @db.Decimal(14, 2)
  // Pricing rule applied at checkout (snapshot).
  priceListId        String?          @db.Char(36)
  pricingMetric      PricingMetric    @default(PURCHASE_QUANTITY)
  rateApplication    RateApplication  @default(WHOLE_PURCHASE)
  // Volume already counted by the metric before this line (monthly metric), and the per-tier split.
  metricVolumeBefore Int              @default(0)
  breakdown          Json?
  createdAt          DateTime         @default(now())

  payment     Payment        @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  network     SmsNetwork     @relation(fields: [networkId], references: [id], onDelete: Restrict)
  pricingTier SmsPricingTier @relation(fields: [pricingTierId], references: [id], onDelete: Restrict)
  priceList   SmsPriceList?  @relation(fields: [priceListId], references: [id], onDelete: Restrict)

  @@unique([paymentId, networkId])
  @@index([networkId])
  @@map("payment_items")
}

// Raw provider notifications, deduplicated for webhook idempotency.
model PaymentEvent {
  id              String    @id @default(uuid()) @db.Char(36)
  paymentId       String?   @db.Char(36)
  provider        String
  providerEventId String
  eventType       String
  payload         Json
  processedAt     DateTime?
  createdAt       DateTime  @default(now())

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([paymentId])
  @@map("payment_events")
}

model Invoice {
  id             String        @id @default(uuid()) @db.Char(36)
  number         String        @unique
  organizationId String        @db.Char(36)
  paymentId      String        @unique @db.Char(36)
  // Snapshot of billing identity at issue time.
  customerName   String        @db.Text
  customerEmail  String?       @db.Text
  billingAddress String?       @db.Text
  taxId          String?
  description    String        @db.Text
  quantity       Int
  unitPrice      Decimal       @db.Decimal(14, 4)
  subtotal       Decimal       @db.Decimal(14, 2)
  taxRate        Decimal       @db.Decimal(5, 2)
  taxAmount      Decimal       @db.Decimal(14, 2)
  total          Decimal       @db.Decimal(14, 2)
  currency       String
  status         InvoiceStatus @default(PAID)
  issuedAt       DateTime      @default(now())
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  payment      Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([organizationId, issuedAt])
  @@map("invoices")
}

// Distributed lease for periodic sweeps: only one process runs a given task at a time.
model JobLease {
  name        String   @id
  owner       String
  lockedUntil DateTime

  @@map("job_leases")
}

// One row per successful credit sale (the revenue side of the business).
model CustomerPurchase {
  id                    String   @id @default(uuid()) @db.Char(36)
  organizationId        String   @db.Char(36)
  paymentId             String   @unique @db.Char(36)
  packageId             String?  @db.Char(36)
  packageName           String
  credits               Int
  revenue               Decimal  @db.Decimal(14, 2)
  // Provider cost of the credits sold, estimated at sale time (package estimate or weighted-average provider cost).
  estimatedProviderCost Decimal  @db.Decimal(14, 2)
  paymentFee            Decimal  @db.Decimal(14, 2)
  // revenue - estimatedProviderCost - paymentFee
  contribution          Decimal  @db.Decimal(14, 2)
  currency              String
  createdAt             DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  payment      Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  package      SmsPackage?  @relation(fields: [packageId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([createdAt])
  @@map("customer_purchases")
}

model Refund {
  id              String   @id @default(uuid()) @db.Char(36)
  organizationId  String   @db.Char(36)
  paymentId       String   @unique @db.Char(36)
  amount          Decimal  @db.Decimal(14, 2)
  currency        String
  creditsReversed Int
  reason          String   @db.Text
  createdById     String?  @db.Char(36)
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  payment      Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@map("refunds")
}

enum ExpenseCategory {
  INFRASTRUCTURE
  SOFTWARE
  PERSONNEL
  MARKETING
  REGULATORY
  PAYMENT_PROCESSING
  OTHER
}

// Operating expenses not already captured by provider purchases or payment fees.
model Expense {
  id          String          @id @default(uuid()) @db.Char(36)
  category    ExpenseCategory
  description String          @db.Text
  vendor      String?
  reference   String?
  amount      Decimal         @db.Decimal(14, 2)
  currency    String
  incurredAt  DateTime
  createdById String?         @db.Char(36)
  deletedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([incurredAt])
  @@map("expenses")
}

model ContactInquiry {
  id          String    @id @default(uuid()) @db.Char(36)
  name        String
  email       String    @db.VarChar(255)
  phone       String?
  company     String?
  message     String    @db.Text
  status      String    @default("NEW")
  ipAddress   String?
  handledAt   DateTime?
  handledById String?   @db.Char(36)
  createdAt   DateTime  @default(now())

  @@index([status, createdAt])
  @@map("contact_inquiries")
}

model Counter {
  key   String @id
  value Int    @default(0)

  @@map("counters")
}

// ─────────────────────────────────────────────────────────────
// Contacts
// ─────────────────────────────────────────────────────────────

model Contact {
  id             String        @id @default(uuid()) @db.Char(36)
  organizationId String        @db.Char(36)
  name           String?
  phone          String
  email          String?       @db.Text
  tags           Json
  status         ContactStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization       Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  groups             ContactGroupMember[]
  campaignRecipients CampaignRecipient[]

  @@unique([organizationId, phone])
  @@index([organizationId, createdAt])
  @@index([phone])
  @@map("contacts")
}

model ContactGroup {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @db.Char(36)
  name           String
  description    String?  @db.Text
  color          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      ContactGroupMember[]
  campaigns    CampaignGroup[]

  @@unique([organizationId, name])
  @@map("contact_groups")
}

model ContactGroupMember {
  groupId   String   @db.Char(36)
  contactId String   @db.Char(36)
  createdAt DateTime @default(now())

  group   ContactGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  contact Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([groupId, contactId])
  @@index([contactId])
  @@map("contact_group_members")
}

// ─────────────────────────────────────────────────────────────
// Campaigns & messaging
// ─────────────────────────────────────────────────────────────

model Campaign {
  id             String         @id @default(uuid()) @db.Char(36)
  organizationId String         @db.Char(36)
  name           String
  senderId       String         @db.Char(36)
  message        String         @db.Text
  status         CampaignStatus @default(DRAFT)
  scheduledAt    DateTime?
  timezone       String         @default("Africa/Kigali")
  failureReason  String?        @db.Text
  // Destination networks the campaign is limited to (JSON array of network ids; null = any configured network).
  networkIds     Json?
  createdById    String         @db.Char(36)
  launchedAt     DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sender       SenderId            @relation(fields: [senderId], references: [id], onDelete: Restrict)
  groups       CampaignGroup[]
  recipients   CampaignRecipient[]
  smsMessage   SmsMessage?

  @@index([organizationId, createdAt])
  @@index([status])
  @@map("campaigns")
}

// Audience: whole contact groups...
model CampaignGroup {
  campaignId String @db.Char(36)
  groupId    String @db.Char(36)

  campaign Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  group    ContactGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@id([campaignId, groupId])
  @@map("campaign_groups")
}

// ...plus individually selected contacts or raw numbers.
model CampaignRecipient {
  id         String   @id @default(uuid()) @db.Char(36)
  campaignId String   @db.Char(36)
  contactId  String?  @db.Char(36)
  phone      String
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([campaignId, phone])
  @@index([campaignId])
  @@map("campaign_recipients")
}

// One send request (single SMS, bulk send, API call or campaign launch).
model SmsMessage {
  id                  String         @id @default(uuid()) @db.Char(36)
  organizationId      String         @db.Char(36)
  senderId            String         @db.Char(36)
  senderName          String
  campaignId          String?        @unique @db.Char(36)
  apiKeyId            String?        @db.Char(36)
  createdById         String?        @db.Char(36)
  source              SmsSource
  body                String         @db.Text
  characterCount      Int
  encoding            SmsEncoding
  segments            Int
  // Segmentation configuration version the message was measured and billed with (never recalculated).
  segmentationVersion Int?
  recipientCount      Int
  creditsPerRecipient Int
  totalCredits        Int
  status              SmsBatchStatus @default(QUEUED)
  scheduledAt         DateTime?
  timezone            String?
  idempotencyKey      String?
  clientReference     String?
  processedAt         DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sender       SenderId               @relation(fields: [senderId], references: [id], onDelete: Restrict)
  campaign     Campaign?              @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  apiKey       ApiKey?                @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  recipients   SmsRecipient[]
  segmentation SmsSegmentationConfig? @relation(fields: [segmentationVersion], references: [version], onDelete: Restrict)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, createdAt])
  @@index([status, scheduledAt])
  @@map("sms_messages")
}

// SMS segmentation rules, versioned and append-only (enforced by DB triggers). The highest version
// is active; each message records the version it was billed with. Limits are in encoding units
// (GSM-7 septets / UCS-2 code units).
model SmsSegmentationConfig {
  version              Int      @id
  gsm7SingleSegment    Int
  gsm7MultiSegment     Int
  ucs2SingleSegment    Int
  ucs2MultiSegment     Int
  // Longest message accepted, in characters.
  maxMessageCharacters Int
  reason               String?  @db.Text
  createdById          String?  @db.Char(36)
  createdAt            DateTime @default(now())

  messages SmsMessage[]

  @@map("sms_segmentation_configs")
}

// Per-recipient delivery unit. This is the "message id" exposed through the public API.
model SmsRecipient {
  id                String             @id @default(uuid()) @db.Char(36)
  messageId         String             @db.Char(36)
  organizationId    String             @db.Char(36)
  campaignId        String?            @db.Char(36)
  contactId         String?            @db.Char(36)
  phone             String
  status            SmsRecipientStatus @default(QUEUED)
  credits           Int
  // Adapter key (e.g. mtn:simulation) and the provider account the message was routed to.
  provider          String?
  providerId        String?            @db.Char(36)
  // Provider cost of this recipient's segments: exact cost of the provider capacity lots consumed at
  // routing time ([{ lotId, segments, unitCost }] in costLots). Never recalculated.
  providerCost      Decimal?           @db.Decimal(14, 4)
  costLots          Json?
  // Customer revenue of this recipient's credits: Σ credits × the selling price of the customer credit
  // lots they were drawn from ([{ lotId, credits, unitPrice }] in revenueLots). Never recalculated.
  // Realized (counted as SMS revenue/gross profit) once a provider accepted the message and it was not refunded.
  revenue           Decimal?           @db.Decimal(14, 4)
  revenueLots       Json?
  // Routing decision: destination country/network, the rule that selected the provider (null = default
  // routing) and a short note (e.g. backup used and why). Never recalculated.
  countryCode       String?            @db.Char(2)
  networkId         String?            @db.Char(36)
  routingRuleId     String?            @db.Char(36)
  routingNote       String?
  capacityReleased  Boolean            @default(false)
  providerMessageId String?            @unique
  errorCode         String?
  errorMessage      String?            @db.Text
  attempts          Int                @default(0)
  refunded          Boolean            @default(false)
  submittedAt       DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  message         SmsMessage          @relation(fields: [messageId], references: [id], onDelete: Cascade)
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  smsProvider     SmsProvider?        @relation(fields: [providerId], references: [id], onDelete: SetNull)
  routingRule     SmsRoutingRule?     @relation(fields: [routingRuleId], references: [id], onDelete: SetNull)
  network         SmsNetwork?         @relation(fields: [networkId], references: [id], onDelete: SetNull)
  deliveryReports SmsDeliveryReport[]

  @@index([messageId, status])
  @@index([organizationId, createdAt])
  @@index([campaignId])
  @@index([status, updatedAt])
  @@index([phone])
  @@map("sms_recipients")
}

model SmsDeliveryReport {
  id                String               @id @default(uuid()) @db.Char(36)
  recipientId       String               @db.Char(36)
  providerMessageId String?
  provider          String
  status            SmsRecipientStatus
  providerStatus    String?
  errorCode         String?
  errorMessage      String?              @db.Text
  source            DeliveryReportSource
  payload           Json?
  occurredAt        DateTime
  createdAt         DateTime             @default(now())

  recipient SmsRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId])
  @@index([providerMessageId])
  @@map("sms_delivery_reports")
}

// ─────────────────────────────────────────────────────────────
// Developer platform
// ─────────────────────────────────────────────────────────────

model ApiKey {
  id                 String    @id @default(uuid()) @db.Char(36)
  organizationId     String    @db.Char(36)
  name               String
  // Public identifier embedded in the key; used for lookup.
  prefix             String    @unique
  // HMAC-SHA256(pepper, secret). The raw secret is shown exactly once.
  keyHash            String
  lastFour           String
  scopes             Json
  allowedIps         Json
  // Descriptive environment label (production / staging / development).
  environment        String    @default("production")
  isEnabled          Boolean   @default(true)
  // Per-key override of the public API rate limit (requests/minute).
  rateLimitPerMinute Int?
  createdById        String    @db.Char(36)
  lastUsedAt         DateTime?
  lastUsedIp         String?
  usageCount         Int       @default(0)
  expiresAt          DateTime?
  revokedAt          DateTime?
  revokedById        String?   @db.Char(36)
  createdAt          DateTime  @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User            @relation(fields: [createdById], references: [id])
  smsMessages  SmsMessage[]
  logs         ApiRequestLog[]

  @@index([organizationId])
  @@map("api_keys")
}

model ApiRequestLog {
  id             String   @id @default(uuid()) @db.Char(36)
  organizationId String   @db.Char(36)
  apiKeyId       String?  @db.Char(36)
  method         String
  path           String   @db.Text
  statusCode     Int
  durationMs     Int
  ipAddress      String?
  userAgent      String?  @db.Text
  errorCode      String?
  requestId      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  apiKey       ApiKey?      @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([apiKeyId, createdAt])
  @@map("api_request_logs")
}

model Webhook {
  id              String   @id @default(uuid()) @db.Char(36)
  organizationId  String   @db.Char(36)
  url             String   @db.Text
  description     String?  @db.Text
  events          Json
  // AES-256-GCM encrypted signing secret (needed in plaintext to sign payloads).
  secretEncrypted String   @db.Text
  isActive        Boolean  @default(true)
  createdById     String   @db.Char(36)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   WebhookDelivery[]

  @@index([organizationId])
  @@map("webhooks")
}

model WebhookDelivery {
  id             String                @id @default(uuid()) @db.Char(36)
  webhookId      String                @db.Char(36)
  organizationId String                @db.Char(36)
  event          String
  eventId        String
  payload        Json
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  nextAttemptAt  DateTime?
  responseStatus Int?
  responseBody   String?               @db.Text
  lastError      String?               @db.Text
  durationMs     Int?
  deliveredAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@unique([webhookId, eventId])
  @@index([status, nextAttemptAt])
  @@index([organizationId, createdAt])
  @@map("webhook_deliveries")
}

// ─────────────────────────────────────────────────────────────
// Platform services
// ─────────────────────────────────────────────────────────────

model Notification {
  id             String    @id @default(uuid()) @db.Char(36)
  userId         String    @db.Char(36)
  organizationId String?   @db.Char(36)
  type           String
  title          String    @db.Text
  body           String    @db.Text
  link           String?   @db.Text
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model AuditLog {
  id             String    @id @default(uuid()) @db.Char(36)
  actorType      ActorType
  // Set when actorType = USER
  actorId        String?   @db.Char(36)
  // Set when actorType = API_KEY
  apiKeyId       String?   @db.Char(36)
  actorEmail     String?
  organizationId String?   @db.Char(36)
  action         String
  resource       String
  resourceId     String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?   @db.Text
  requestId      String?
  createdAt      DateTime  @default(now())

  actor        User?         @relation(fields: [actorId], references: [id], onDelete: Restrict)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model SystemSetting {
  key         String   @id
  value       Json
  description String?  @db.Text
  updatedById String?  @db.Char(36)
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

// Outbound email outbox. The configured mailer driver delivers these.
model EmailMessage {
  id        String      @id @default(uuid()) @db.Char(36)
  to        String      @db.VarChar(255)
  subject   String      @db.Text
  text      String      @db.MediumText
  html      String?     @db.MediumText
  template  String
  status    EmailStatus @default(PENDING)
  error     String?
  sentAt    DateTime?
  createdAt DateTime    @default(now())

  @@index([to, createdAt])
  @@map("email_messages")
}

// State store owned by the *simulated* external providers (SMS + payments).
// Business logic never reads this table; it stands in for the provider's own systems.
model SimulatorRecord {
  id        String   @id
  kind      String
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind])
  @@map("simulator_records")
}

// Platform-level credentials for trusted external systems (e.g. the finance system). Unlike
// api_keys these are not tied to an organization; a Super Admin issues, scopes and revokes them.
model IntegrationClient {
  id                 String    @id @default(uuid()) @db.Char(36)
  name               String
  // Public identifier embedded in the key; used for lookup.
  prefix             String    @unique
  // HMAC-SHA256(pepper, secret). The raw secret is shown exactly once.
  keyHash            String
  lastFour           String
  // Rotation overlap: the previous secret keeps working until previousValidUntil.
  previousKeyHash    String?
  previousValidUntil DateTime?
  rotatedAt          DateTime?
  scopes             Json
  allowedIps         Json
  isEnabled          Boolean   @default(true)
  expiresAt          DateTime?
  // Non-interactive service account the credential acts as (audit trail, ownership columns).
  userId             String?   @db.Char(36)
  createdById        String    @db.Char(36)
  lastUsedAt         DateTime?
  lastUsedIp         String?
  usageCount         Int       @default(0)
  revokedAt          DateTime?
  revokedById        String?   @db.Char(36)
  createdAt          DateTime  @default(now())

  @@map("integration_clients")
}

// Replay protection for requests made with an API credential. The unique key makes concurrent
// retries safe: only one request can claim (credentialId, key); the rest replay or wait.
model IdempotencyRecord {
  id           String   @id @default(uuid()) @db.Char(36)
  credentialId String   @db.Char(36)
  key          String   @db.VarChar(100)
  method       String   @db.VarChar(10)
  path         String   @db.VarChar(255)
  // SHA-256 of method + path + body: the same key with a different request is rejected.
  requestHash  String   @db.Char(64)
  // null while the first request is still running.
  statusCode   Int?
  responseBody Json?
  createdAt    DateTime @default(now())

  @@unique([credentialId, key])
  @@index([createdAt])
  @@map("idempotency_records")
}

// One row per request made with a platform integration credential (never stores secrets or bodies).
model IntegrationRequestLog {
  id           String   @id @default(uuid()) @db.Char(36)
  credentialId String   @db.Char(36)
  method       String   @db.VarChar(10)
  path         String   @db.VarChar(255)
  statusCode   Int
  durationMs   Int
  ipAddress    String?
  errorCode    String?
  requestId    String?
  createdAt    DateTime @default(now())

  @@index([credentialId, createdAt])
  @@index([createdAt])
  @@map("integration_request_logs")
}
